# Godot 4+ specific ignores
.godot/
/android/

# Windows temp/lock leftovers from GDExtension binaries
~*.TMP
~*.tmp
~*.dll
# 빌드 산출물은 안 올리되 그 폴더의 README 는 올린다. **디렉터리 자체를 무시하면
# git 이 안으로 들어가지 않아 안쪽 예외가 안 먹는다** — 그래서 `/build/` 가 아니라
# `/build/*` 다.
/build/*
!/build/README.md

# 햅틱 네이티브 플러그인은 CI 가 굽는다 — 저장소에 커밋하지 않는다.
# `.gdip` 정적 라이브러리는 엔진 헤더에 컴파일 타임으로 묶이므로, 커밋해 두면
# GODOT_VERSION 을 올리는 순간 낡은 .a 가 조용히 안 맞게 된다.
/ios/plugins/haptics/
/.haptics-src/

# 에디터 개인 설정은 PC 마다 다르다(Godot 실행 파일 경로 등) — 커밋하지 않는다.
# 템플릿만 올리고, 각 PC 에서 settings.example.json 을 settings.json 으로 복사해 경로를 고친다.
/.vscode/*
!/.vscode/settings.example.json

# Claude Code 개인 설정(PC 별 권한·경로) — 커밋하지 않는다. 공용 설정은 .claude/settings.json 에 둔다.
/.claude/settings.local.json
# 병렬 에이전트 작업용 git worktree — 커밋하지 않는다.
/.claude/worktrees/

# UiSceneDump 초안 출력(resources/README.md) — 참고용 초안이라 커밋하지 않는다.
/_dump/

# 현지화 생성물 중 커밋하지 않는 것(docs/localization_design.md §7.4) — 조회 인덱스 · 검증 보고서,
# 그리고 Godot 이 strings_*.csv 를 임포트해 만드는 .translation(열 때 · CI --import 때 다시 생긴다).
/data/l10n/generated/index.json
/data/l10n/generated/report.md
/data/l10n/generated/*.translation
/data/l10n/generated/extract_report.md
/data/l10n/generated/extract_code*.json
