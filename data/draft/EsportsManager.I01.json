                  "text": "You're doing great. Just hang in a bit longer."
                }
              }
            },
            {
              "id": "81139970-3ac2-5b6d-b7cd-95ab55e8a661",
              "text": "힘들면 강도를 조절해 줄게.",
              "next": "2bdfe81f-5c66-589a-af92-1b50ede84648",
              "attrs": {
                "effects": "trust:+4"
              },
              "i18n": {
                "En": {
