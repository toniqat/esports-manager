          "options": [
            {
              "id": "6b469569-fe92-5cc1-b13e-f18243785ff6",
              "text": "잘하고 있어. 조금만 더 버티자.",
              "next": "d660e2a5-cab8-5b7c-8e1f-922aaa09a9eb",
              "attrs": {
                "effects": "ok>trust:+5;ng>trust:+1"
