          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Training's been kind of rough lately."
                },
                {
                  "kind": "text",
                  "text": "What do you think, Coach?"
                }
              ]
            }
          },
          "next": "cdf95302-9c1b-5ef8-a374-d5086f8c7b54"
