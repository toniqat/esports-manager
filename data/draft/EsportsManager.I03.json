          "lines": [
            {
              "kind": "text",
              "text": "요즘 좀 생각이 많아서요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "I've just had a lot on my mind lately."
                }
              ]
