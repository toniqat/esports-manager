          "options": [
            {
              "id": "009fe875-e4e6-57d5-9596-fd4bf9a3fc6c",
              "text": "더 했지. 하루 열네 시간.",
              "next": "6fa70033-f72c-5b60-8382-184738a0c948",
              "attrs": {
                "effects": "ok>trust:+5;ng>trust:+1"
              },
              "i18n": {
                "En": {
                  "text": "Harder. Fourteen hours a day."
                }
              }
            },
            {
              "id": "4841c90a-90c7-5ec1-99d5-c93af83e4920",
              "text": "그땐 몰랐어. 너희는 나보다 낫다.",
              "next": "326a3232-d7bb-5a0f-aec4-c1d818057e3e",
              "attrs": {
                "effects": "trust:+5"
              },
              "i18n": {
                "En": {
                  "text": "I didn't know any better back then. You're all better than I was."
                }
              }
            }
          ]
        },
        "6fa70033-f72c-5b60-8382-184738a0c948": {
          "localId": 6,
          "attrs": {
            "branch": "ok"
          },
          "type": "Dialog",
          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "와… 저도 질 수 없죠!"
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Whoa… then I can't lose either!"
                }
              ]
            }
          },
          "next": "1b56da13-52ca-50fd-8765-fe6e74532cab"
        },
        "1b56da13-52ca-50fd-8765-fe6e74532cab": {
