          "type": "Dialog",
          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "그건 좀 무리 아닌가요…"
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Isn't that a bit much…?"
