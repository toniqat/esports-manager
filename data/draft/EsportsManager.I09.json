          "lines": [
            {
              "kind": "text",
              "text": "감독님 현역 때 얘기 해 주세요!"
            },
            {
              "kind": "text",
              "text": "그때도 이렇게 연습했어요?"
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Tell me about your pro days, Coach!"
                },
                {
                  "kind": "text",
                  "text": "Did you practice this hard back then?"
                }
              ]
            }
          },
          "next": "5b5600db-871c-5214-889e-f7d8996329bf"
        },
        "3aca8b8c-abe9-5912-907a-873ce19121df": {
