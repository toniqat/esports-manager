          "lines": [
            {
              "kind": "text",
              "text": "바람 좋다…"
            },
            {
              "kind": "text",
              "text": "사실 프로 되기 전엔 여기 자주 왔어요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Nice breeze…"
                },
                {
                  "kind": "text",
                  "text": "Actually, I used to come here a lot before I went pro."
                }
              ]
            }
          },
          "next": "03eb1b19-bbbf-5b14-90fe-15a71f750520"
        },
        "9e99485f-0894-5690-9f83-ceae2a86f2a1": {
