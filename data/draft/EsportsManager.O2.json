            "kind": "outing",
            "manager_type": -1,
            "stage": 2,
            "weight": 1
          },
          "type": "Comment",
          "text": "외출 이벤트 설정",
          "attachedTo": "2b254aa3-aa1b-5785-b062-caab3174504d"
        },
        "03eb1b19-bbbf-5b14-90fe-15a71f750520": {
