          "type": "Select",
          "options": [
            {
              "id": "24172621-089a-5f3f-94ee-b70d10e191e3",
              "text": "그때 무슨 생각 했어?",
              "next": "c472d0f4-4bd0-5eaf-9304-9b035728e3d3",
              "attrs": {
                "effects": "trust:+6;pmod:all:+1:-1"
              },
              "i18n": {
                "En": {
                  "text": "What were you thinking about back then?"
                }
              }
            },
            {
              "id": "c20d7e87-9fcc-5b1f-b8f3-9e92dc7b82c8",
              "text": "지금은 어때?",
              "next": "3fa811d8-efdd-5cda-889f-2edb8c1e84d6",
              "attrs": {
                "effects": "trust:+5;pmod:all:+1:-1"
              },
              "i18n": {
                "En": {
                  "text": "And how about now?"
                }
              }
            }
          ]
        },
        "c472d0f4-4bd0-5eaf-9304-9b035728e3d3": {
          "localId": 7,
          "type": "Dialog",
          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "언젠가 무대에 서고 싶다… 그거요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "That I wanted to stand on that stage someday… that's all."
                }
              ]
            }
          },
          "next": "ad677e12-6c80-579d-9317-b9f6c7400c00"
        },
        "3fa811d8-efdd-5cda-889f-2edb8c1e84d6": {
          "localId": 8,
          "type": "Dialog",
          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "지금은… 좋아요. 진짜로."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Now… I'm happy. For real."
                }
              ]
            }
          },
          "next": "ad677e12-6c80-579d-9317-b9f6c7400c00"
