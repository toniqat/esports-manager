          "type": "Dialog",
          "speaker": null,
          "lines": [
            {
              "kind": "text",
              "text": "영화가 끝나고 한참 말이 없다."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "After the movie, neither of you says anything for a while."
