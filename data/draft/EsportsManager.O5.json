          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "감독님. 저 이번 시즌 끝나면 꼭 하고 싶은 말이 있어요."
            },
            {
              "kind": "text",
              "text": "…지금 말하면 반칙이니까 우승하고 할게요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Coach. There's something I really want to tell you when this season's over."
                },
                {
                  "kind": "text",
                  "text": "…Saying it now would be cheating, so I'll tell you after we win."
                }
              ]
            }
          },
          "next": "06d84c12-5e1e-5398-bbf6-85c72bb9707f"
        },
