          "type": "Select",
          "options": [
            {
              "id": "ee4b3935-0e42-529c-9370-c1140013ac2e",
              "text": "그럼 꼭 우승해야겠네.",
              "next": "d43eab2b-18c7-5b73-8d16-2ff966bc1a54",
              "attrs": {
                "effects": "trust:+8;pmod:all:+2:-1"
              },
              "i18n": {
                "En": {
                  "text": "Then we'd better win."
                }
              }
            },
            {
              "id": "d9bb47f6-30ed-5555-bed5-98c923e60797",
              "text": "기다릴게.",
              "next": "01ea888f-6b24-578f-b83e-15f7c403aa33",
              "attrs": {
                "effects": "trust:+8;pmod:all:+2:-1"
              },
              "i18n": {
                "En": {
                  "text": "I'll be waiting."
