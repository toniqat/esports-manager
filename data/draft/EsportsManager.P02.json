          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Many say this weekend's opponent is a tough one."
                },
                {
                  "kind": "text",
                  "text": "Honestly, are you confident you can win?"
                }
              ]
            }
          },
          "next": "58203384-6f60-5de7-8197-0d521946adb9"
        },
