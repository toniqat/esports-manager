          "type": "Select",
          "options": [
            {
              "id": "03e78d2f-cb24-5a06-bd97-028712dbe687",
              "text": "가족 같은 분위기입니다.",
              "next": "13ad6e83-98c7-5a0b-8943-9d3611f8655b",
              "attrs": {
                "effects": "ok>trust_all:+2;ng>trust_all:-1"
              },
              "i18n": {
                "En": {
                  "text": "We're like a family."
                }
              }
            },
            {
              "id": "9d9084fc-03e2-54d5-afb4-acadf732f0ef",
              "text": "경쟁은 있지만 건강한 경쟁입니다.",
