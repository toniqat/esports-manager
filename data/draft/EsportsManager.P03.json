          "lines": [
            {
              "kind": "text",
              "text": "팀 분위기는 어떻습니까?"
            },
            {
              "kind": "text",
              "text": "불화설도 돌던데요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "How's the mood in the team?"
                },
                {
                  "kind": "text",
                  "text": "There have been rumors of friction."
                }
              ]
            }
          },
          "next": "3f4c10e7-50b3-58b9-8d91-0e0bdd9bb5ee"
        },
