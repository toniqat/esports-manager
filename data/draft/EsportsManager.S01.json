          "attrs": {
            "kind": "story",
            "manager_type": -1,
            "stage": 0,
            "weight": 2
          },
          "type": "Comment",
          "text": "이야기 이벤트 설정",
          "attachedTo": "1e374373-4ffb-5a02-a483-1736235d623c"
        },
        "48b8f2d2-1ce4-525f-9ff4-2c705ea91347": {
