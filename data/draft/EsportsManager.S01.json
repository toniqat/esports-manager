          "lines": [
            {
              "kind": "text",
              "text": "오늘 훈련, 솔직히 좀 빡셌어요."
            },
            {
              "kind": "text",
              "text": "그래도 뭔가 감이 오는 것 같기도 하고요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Today's training was rough, honestly."
                },
                {
                  "kind": "text",
                  "text": "But I think I'm starting to get a feel for it."
                }
              ]
            }
          },
          "next": "48b8f2d2-1ce4-525f-9ff4-2c705ea91347"
        },
