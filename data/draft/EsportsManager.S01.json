          "type": "Dialog",
          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "정말요? 감사합니다, 감독님."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Really? Thank you, Coach."
