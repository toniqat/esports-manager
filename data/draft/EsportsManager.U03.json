            "manager_type": -1,
            "stage": 0,
            "cond": "last=loss;deaths>=4",
            "weight": 2
          },
          "type": "Comment",
          "text": "이야기 이벤트 설정",
          "attachedTo": "37e4ee74-05d8-5aa7-9b01-8473e1e5c550"
        },
        "66f880d2-f3a4-5732-9991-4525ae68fa54": {
