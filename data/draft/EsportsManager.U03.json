          "lines": [
            {
              "kind": "text",
              "text": "오늘 너무 많이 잡혔어요… 다 제 탓 같아요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "I got caught way too often today… It feels like my fault."
                }
              ]
            }
          },
          "next": "66f880d2-f3a4-5732-9991-4525ae68fa54"
        },
        "79253f18-d1f3-5426-b7ec-8941738d3192": {
          "localId": 4,
          "attrs": {
