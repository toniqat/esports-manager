          "type": "Select",
          "options": [
            {
              "id": "e748999e-2cb8-51ba-8578-174b7fe5fc1e",
              "text": "네 탓 아니야. 팀 경기였어.",
              "next": "6b80a5f1-8aac-55d8-9978-10208227416b",
              "attrs": {
                "effects": "trust:+3;stress:-8"
              },
              "i18n": {
                "En": {
                  "text": "It's not your fault. It was a team game."
                }
              }
            },
            {
              "id": "890173e8-8f0e-5059-928d-22344dd5d2c2",
              "text": "왜 잡혔는지 같이 보자. 다음엔 안 그래.",
              "next": "5733e3af-c066-5fa2-b40e-5eb1eb5fa920",
              "attrs": {
                "effects": "awaken:+10;stress:+5;ok>trust:+2;ng>trust:-2"
              },
              "i18n": {
                "En": {
                  "text": "Let's see why you got caught. Next time you won't."
                }
              }
            }
          ]
        },
        "6b80a5f1-8aac-55d8-9978-10208227416b": {
          "localId": 6,
          "type": "Dialog",
          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "…감사해요, 감독님."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "…Thank you, Coach."
                }
              ]
            }
          },
          "next": "bef2bbdd-9207-5d41-8ac9-fb6f99e96ebc"
        },
        "5733e3af-c066-5fa2-b40e-5eb1eb5fa920": {
          "localId": 7,
          "attrs": {
            "branch": "ok"
          },
          "type": "Dialog",
          "speaker": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
          "lines": [
            {
              "kind": "text",
              "text": "네, 똑같이 당하진 않을 거예요."
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Okay. It won't happen the same way twice."
