          "lines": [
            {
              "kind": "text",
              "text": "집에 한 번만 다녀오면 안 될까요?"
            }
          ],
          "i18n": {
            "En": {
              "lines": [
                {
                  "kind": "text",
                  "text": "Could I go home just once?"
                }
              ]
            }
          },
