          "type": "Select",
          "options": [
            {
              "id": "307827a6-a05e-5c3b-9482-470f0c7f2bce",
              "text": "하루 다녀와. 훈련은 걱정 마.",
              "next": "64ba76b0-660f-5ac0-9a69-0c5d1cf15d88",
              "attrs": {
                "effects": "trust:+6;pmod:all:-1:1"
              },
              "i18n": {
                "En": {
                  "text": "Go for a day. Don't worry about practice."
                }
              }
            },
            {
              "id": "7bde67f6-1f14-56f5-a85f-1916f64a4cb7",
              "text": "시즌 끝나고 꼭 보내 줄게.",
              "next": "c4bcfe70-e2d9-5867-a989-62210cf3b74d",
              "attrs": {
                "effects": "ok>trust:+2;ng>trust:-3"
              },
              "i18n": {
                "En": {
                  "text": "I'll make sure you go once the season's over."
                }
              }
            }
          ]
        },
        "64ba76b0-660f-5ac0-9a69-0c5d1cf15d88": {
