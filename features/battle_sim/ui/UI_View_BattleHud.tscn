[node name="BattleHud" type="Node"]
editor_description = "전투 HUD — HudBuilder.build_ui() 가 인스턴스해 BattleSim 아래에 붙인다. 좌표는 1080×1920 디자인 값이고, 기기 안전 영역은 코드가 덩어리째 민다(위 = top_offset, 아래 = 아래 인셋). 같은 층 번호(1)의 두 CanvasLayer 는 형제 순서가 그리는 순서다 — EnemyTopLayer 가 Canvas 앞에 서야 한다."

[node name="EnemyTopLayer" type="CanvasLayer" parent="."]
editor_description = "[필수] 지우면 오류 — HudBuilder.gd _enemy_top_layer: 상단 적 UI(적 스트립 + 뒤판 + 상대 손패 peek)만 담는 전용 층."
unique_name_in_owner = true

[node name="AiHand" type="Control" parent="EnemyTopLayer"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — HudBuilder.gd _ai_hand_root
상대 손패 peek — 뒷면 카드 부채꼴(Card.tscn × 손패 수)을 코드가 여기에 세운다(HudBuilder._layout_ai_hand)."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

