[node name="PilotDetail" type="Control"]
editor_description = "파일럿 상세 한 장 — PilotDetailPanel 이 열 때마다 하나씩 인스턴스한다(닫히는 장이 빠져나가는 동안 다음 장이 들어올 수 있게). 모달: 루트 · 딤이 뒤쪽 입력을 전부 삼킨다."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")

[node name="Dim" type="Panel" parent="."]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — PilotDetailPanel.gd _dim: 딤 / 정보 묶음(머리글 · 탭 · 본문 · 카드).
딤 = \"바깥\" — 탭 · 칸 · 카드 · 사용 버튼이 아닌 곳을 누르면(뗄 때) 닫힌다. 정보 칼럼 · 카드 부채꼴 근처는 예외(코드)."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"BattleDimPanel"

