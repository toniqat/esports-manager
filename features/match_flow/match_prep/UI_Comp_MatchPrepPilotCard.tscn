[node name="MatchPrepPilotCard" type="PanelContainer"]
editor_description = "PREP pilot card (five per team in a row, seat order). Width comes from the row (expand), height = content. Own team: SeasonPilotCard part (trust ring / level pill, stress). Opponent: EnemyTop (badge + portrait), red Warn chip when the analyst flags the pilot. Both: stat total (big) + up to two mech chips. Tap = pressed(pilot_id)."
