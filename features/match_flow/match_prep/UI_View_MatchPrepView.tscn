size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="EnemyIntelPad" type="MarginContainer" parent="Safe/Scroll/Body"]
editor_description = "오른쪽 8 = 스크롤 막대(8)와 합쳐 끝이 스크롤 오른쪽 끝에서 16 떨어진다."
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_right = 48

[node name="IntelView_EnemyIntel" parent="Safe/Scroll/Body/EnemyIntelPad" instance=ExtResource("3_intel")]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — MatchPrepView.gd fill()
상대 팀 분석 메모 — IntelView 씬(리그 팀 상세와 공용)을 show_rows = false · show_header = false 로: 분석 메모(왼쪽 분석가 썸네일) 또는 분석 담당 없음 한 줄만. 분석 단계 칩은 PREP 에서 뺐다(2026-10). 선수는 아래 카드 줄."
layout_mode = 2
show_rows = false
show_header = false

[node name="TopSpace" type="Control" parent="Safe/Scroll/Body"]
