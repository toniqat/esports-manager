[node name="Body" type="VBoxContainer" parent="Safe/Scroll"]
editor_description = "Fills the scroll height (expand): analyst note on top, then the enemy cards · versus block · own cards centred in the rest by the two expand spacers (they collapse to 0 when the content is taller than the scroll)."
layout_mode = 2
