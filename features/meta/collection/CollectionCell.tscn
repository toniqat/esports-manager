[node name="CollectionCell" type="Button"]
editor_description = "One cell of the 컬렉션 grid (CollectionTab %Grid), 240x330. Frame = variation by owned state (code, CollectionCell.FRAME_*). Owned: name + Lv + breakthrough pips. Unowned: dimmed face (ArtMask modulate), 미보유 pill, hint. Face, role badge, rarity stars / colour / width and the pip count are data → code. Mouse = Pass (the grid is a DragScroll)."
custom_minimum_size = Vector2(240, 330)
offset_right = 240.0
offset_bottom = 330.0
focus_mode = 0
mouse_filter = 1
theme = ExtResource("2_theme")
theme_type_variation = &"CollectionCellFrame"
script = ExtResource("1_cell")

