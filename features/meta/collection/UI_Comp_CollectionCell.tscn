[node name="CollectionCell" type="Button"]
editor_description = "One cell of the 컬렉션 grid (CollectionTab %Grid), 240x240 — owned pilots only. Square face (role badge top-left), level ribbon bottom-left and rank stars bottom-right inside the face. Face, role, level and the star count / state are data → code. Mouse = Pass (the grid is a DragScroll)."
custom_minimum_size = Vector2(240, 240)
offset_right = 240.0
offset_bottom = 240.0
focus_mode = 0
mouse_filter = 1
theme = ExtResource("2_theme")
theme_type_variation = &"CollectionCellFrame"
script = ExtResource("1_cell")

[node name="ArtMask" type="Panel" parent="."]
editor_description = "Rounded face crop: the white mask clips its children (clip_children) — the face and the two corner tabs, so the tabs follow the rounded corners. Inset 8."
clip_children = 1
layout_mode = 0
offset_left = 8.0
offset_top = 8.0
offset_right = 232.0
offset_bottom = 232.0
mouse_filter = 2
theme_type_variation = &"CollectionCellArtMask"

