[node name="ManagerPopup" type="Control"]
editor_description = "Lobby 감독 modal (opened by the top-left level disc). A sheet that drops from the top edge + the floating close capsule bottom-right. A Control child of the lobby (not a CanvasLayer) so the lobby toast (z 5) floats over it; ConfirmPopup / ManagerTypePopup / the trait swap popup are CanvasLayers above. Hosts ManagerTab in %Body; every edit there saves at once (no action bar)."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

