[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://features/meta/run_setup/ChoiceListView.gd" id="1_list"]
[ext_resource type="Theme" uid="uid://co7tw5omdwmyd" path="res://resources/OutgameTheme.tres" id="2_theme"]

[node name="ChoiceListView" type="Control"]
editor_description = "Base of the 'pick one card' run-setup steps. ScenarioStepView.tscn / TeamStepView.tscn inherit this scene and swap the root script; edit shared layout here."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
theme = ExtResource("2_theme")
script = ExtResource("1_list")

[node name="Safe" type="Control" parent="."]
unique_name_in_owner = true
editor_description = "Safe area of the step — code sets offset_bottom = -bottom inset (RunSetupScreen.fit_insets)."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Hint" type="Label" parent="Safe"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 32.0
offset_top = 116.0
offset_right = -32.0
offset_bottom = 160.0
grow_horizontal = 2
theme_type_variation = &"SubLabel"
theme_override_font_sizes/font_size = 24
text = "시나리오가 샐러리캡을 정합니다 — 다섯 선수의 샐러리 합이 캡을 넘으면 시작할 수 없습니다."
clip_text = true

[node name="Scroll" type="ScrollContainer" parent="Safe"]
unique_name_in_owner = true
editor_description = "Card list: 8px under the hint, down to 16px above the bottom bar (bar 128 + 16). Grows to the RIGHT only: when the list overflows, the scroll bar adds its width outside the 1032 list (same as the old code-built list), so the cards keep their x."
layout_mode = 1
anchors_preset = -1
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 168.0
offset_right = -24.0
offset_bottom = -144.0
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Safe/Scroll"]
unique_name_in_owner = true
editor_description = "Cards are instantiated here by code (one item scene per row of the step's table). Minimum width 1032 = full list width, so the scroll bar overlays the cards' right edge instead of narrowing them."
custom_minimum_size = Vector2(1032, 0)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
theme_override_constants/separation = 20

[node name="Bar" type="HBoxContainer" parent="."]
unique_name_in_owner = true
editor_description = "Bottom action bar 뒤로 (1) / 다음 (2). Code adds the bottom inset and squares the corners (RunSetupScreen.fit_insets)."
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -128.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 0

[node name="Back" type="Button" parent="Bar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_type_variation = &"GhostButton"
theme_override_font_sizes/font_size = 30
