[node name="PilotThumb" type="Button"]
editor_description = "One cell of the lineup grid (TeamDraftView %Grid). 200x240 (portrait cell; the square face is cover-cropped). Frame = variation SelectableCardButton / SelectableCardButtonOn (radius 18), switched by code (_apply_style); ArtMask radius 14 = 18 - its 4px inset. Same corners as the lineup slots (DraftSlot): top-left overall big + position small, top-right salary tag (icon + number), bottom-left rank stars (돌파), bottom-right level. Selected = gold border + centre check. All values are data → code."
clip_contents = true
custom_minimum_size = Vector2(200, 240)
offset_right = 200.0
offset_bottom = 240.0
focus_mode = 0
mouse_filter = 1
theme = ExtResource("2_theme")
