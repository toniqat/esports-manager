[node name="RunTeamBanner" type="Control"]
editor_description = "Chosen team's banner during run setup (after the 팀 step): banner art background (fallback = team colour), logo + short name (big) + full name (small). Two head arrangements: %HeadStrip (left, vertically centred — 감독 strip) and %HeadTop (compact, centred along the top — lineup backdrop); RunTeamBanner.centered / .square pick head and mask. Size = the parent's (preview 1032 x 148). Data → code (fill)."
custom_minimum_size = Vector2(0, 148)
layout_mode = 3
anchors_preset = 0
offset_right = 1032.0
offset_bottom = 148.0
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

