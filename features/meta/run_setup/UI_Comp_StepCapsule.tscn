[node name="StepCapsule" type="Control"]
editor_description = "Run-setup step header: dark floating capsule, one 40px icon per header step of RunSetupScreen.STEPS (팀 · 감독 · 편성 — the scenario pick is not a header step; 120 apart, 20 padding) and a white disc (%Selector, icon + 12 each side) behind the current step. Disc position, icon tints (current dark / done amber / upcoming faint) and the slide off the screen top (lineup CONFIRM) = code (StepCapsule.gd). Size 400 x 80."
custom_minimum_size = Vector2(400, 80)
layout_mode = 3
anchors_preset = 0
offset_right = 400.0
offset_bottom = 80.0
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_cap")

[node name="Back" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
