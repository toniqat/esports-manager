[node name="TeamCard" type="Button"]
editor_description = "One team-package card of the team step's 3-column grid (TeamStepView). The whole card is the tap target; selected / not = variation SelectableCardButton / SelectableCardButtonOn, switched by code (ChoiceListView._refresh). The team banner sits inside BannerMask, inset by SELECT_BORDER_ON (4) so the amber selected border stays visible. 336 x 300: logo centred at the top, short name (big) + full name under it, budget · facility level small along the bottom."
