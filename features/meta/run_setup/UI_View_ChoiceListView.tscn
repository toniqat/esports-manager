[node name="ChoiceListView" type="Control"]
editor_description = "Base of the 'pick one card' run-setup steps. UI_View_ScenarioStepView.tscn / UI_View_TeamStepView.tscn inherit this scene and swap the root script; edit shared layout here."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
theme = ExtResource("2_theme")
script = ExtResource("1_list")

[node name="Safe" type="Control" parent="."]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — ChoiceListView.gd _build()
Safe area of the step — code sets offset_bottom = -bottom inset (OutgameTheme.fit_bottom_bar)."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Hint" type="Label" parent="Safe"]
auto_translate_mode = 2
editor_description = "[필수] 지우면 오류 — ChoiceListView.gd _build() · ChoiceListView.gd _fill_preview()"
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 32.0
offset_top = 116.0
offset_right = -32.0
offset_bottom = 160.0
grow_horizontal = 2
theme_type_variation = &"SubLabel"
theme_override_font_sizes/font_size = 24
text = "시나리오가 샐러리캡을 정합니다 — 다섯 선수의 샐러리 합이 캡을 넘으면 시작할 수 없습니다."
clip_text = true

[node name="Scroll" type="ScrollContainer" parent="Safe"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — ChoiceListView.gd _build()
Card list: 8px under the hint, down to the screen bottom (code adds the bottom inset) — the cards scroll under the floating bottom capsules and stay visible there; %BarShield keeps taps in that zone off the cards, %ListPad lets the last card scroll clear of it. Grows to the RIGHT only: when the list overflows, the scroll bar adds its width outside the 1032 list (same as the old code-built list), so the cards keep their x."
layout_mode = 1
anchors_preset = -1
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 168.0
offset_right = -24.0
offset_bottom = 0.0
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="ListPad" type="MarginContainer" parent="Safe/Scroll"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — ChoiceListView.gd _build()
Bottom margin = the bottom capsule zone (OutgameTheme.bar_scroll_pad(), set by code) so the last card can scroll above the capsules."
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/margin_bottom = 140

[node name="List" type="VBoxContainer" parent="Safe/Scroll/ListPad"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — ChoiceListView.gd _build() · ChoiceListView.gd _fill_preview()
Cards are instantiated here by code (one item scene per row of the step's table). Minimum width 1032 = full list width, so the scroll bar overlays the cards' right edge instead of narrowing them."
custom_minimum_size = Vector2(1032, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 20

[node name="BarShield" type="Control" parent="."]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — ChoiceListView.gd _build()
Invisible input blocker over the bottom capsule zone (full width, bar top → screen bottom; OutgameTheme.fit_bar_shield). The list shows through it but taps there never pick a card. Drawn above %Safe, below %Bar."
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -128.0
grow_horizontal = 2
grow_vertical = 0

[node name="Bar" type="HBoxContainer" parent="."]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — ChoiceListView.gd _build()
Bottom action bar 뒤로 (1) / 다음 (2) — floating capsules (BarDarkButton · BarPrimaryButton), 16 apart. Code adds only the bottom inset (OutgameTheme.fit_bottom_bar)."
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = -128.0
offset_right = -40.0
offset_bottom = -32.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 16

