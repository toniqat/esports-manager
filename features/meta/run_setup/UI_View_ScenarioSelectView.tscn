[node name="ScenarioSelectView" type="Control"]
editor_description = "Full-screen scenario (league) pick, hosted INSIDE the lobby (full rect under the lobby top bar; the lobby level / settings discs stay drawn above it). Art (full viewport height, cover-cropped around scenarios.csv art_focus_x) + black wipe for art changes + dark slanted sheet that swings in counter-clockwise: salary-cap card (bottom-left), league logo / name / index pills between arrows (bottom-right), bar 뒤로 / 시나리오 선택. ScenarioSelectView.gd fills data and runs the animations."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_view")

