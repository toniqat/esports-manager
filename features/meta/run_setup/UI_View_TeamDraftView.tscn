[node name="GridScroll" type="ScrollContainer" parent="Safe/PickPane"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — TeamDraftView.gd _ready()
Shows 3.5 rows of 240px cells above the capsules. OutgameTheme.fit_bar_scroll ends its scroll bar a little above the capsule row. Runs down to the screen bottom (code adds the bottom inset): the list scrolls under the floating bottom capsules and stays visible there; %BarShield keeps taps in that zone off the thumbnails, %GridPad lets the last row scroll clear of it."
layout_mode = 1
anchors_preset = -1
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -864.0
offset_right = -24.0
offset_bottom = 0.0
grow_vertical = 0
horizontal_scroll_mode = 0

[node name="GridPad" type="MarginContainer" parent="Safe/PickPane/GridScroll"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — TeamDraftView.gd _fit_grid_to_bottom()
Bottom margin = the bottom capsule zone (OutgameTheme.bar_scroll_pad(): BOTTOM_BAR_H + 12 + inset, set by code) so the last thumbnail row can scroll above the capsules."
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
