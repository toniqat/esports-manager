[node name="CurrencyShopPopup" type="Control"]
editor_description = "Lobby currency shop (opened by the top-right wallet pills). Top: premium → coin bundles; bottom: dev cash → premium packs. Each section is a 3 × 2 grid of CurrencyShopProduct tiles. A Control child of the lobby so the lobby toast (z 5) floats over it."
