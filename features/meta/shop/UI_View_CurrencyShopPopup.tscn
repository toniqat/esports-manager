[node name="CurrencyShopPopup" type="Control"]
editor_description = "Lobby currency shop (opened by the top-right wallet pills) — a sheet that drops from the top edge (height = content) + the floating close capsule bottom-right. Top: premium → coin bundles; bottom: dev cash → premium packs. Each section is a 3 × 2 grid of CurrencyShopProduct tiles. A Control child of the lobby so the lobby toast (z 5) floats over it."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

