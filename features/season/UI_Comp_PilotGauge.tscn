[node name="PilotGauge" type="Control"]
auto_translate_mode = 2
editor_description = "One small stat gauge of a SeasonPilotCard (stress / trust), no panel: flat icon inside a radial ring at the top, optional number in the icon (trust level), the value under the ring (stress number · trust %) and the change under that (+N / +N%, %Delta, week screen only). PilotGauge.gd picks the kind, icon and colours; %Mask darkens the ring when the pilot cannot be picked."
custom_minimum_size = Vector2(48, 80)
layout_mode = 3
anchors_preset = 0
offset_right = 48.0
offset_bottom = 80.0
mouse_filter = 2
