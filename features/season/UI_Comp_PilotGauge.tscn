[node name="PilotGauge" type="Control"]
auto_translate_mode = 2
editor_description = "One stat flag of a SeasonPilotCard (stress / trust): a tall white pentagon pennant pointing down (%Flag), its top tucked under the card's portrait plate. In it, top to bottom: the bottom-half gauge (%Ring, fills left → right) with the flat icon in its bowl (trust: the level inside the heart, %Center), the value (stress number · trust %) and the change (+N / +N%, %Delta, week screen only). Width comes from the card's %Gauges row (expand). PilotGauge.gd picks the kind, icon and colours."
custom_minimum_size = Vector2(60, 108)
layout_mode = 3
anchors_preset = 0
offset_right = 80.0
offset_bottom = 108.0
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_gauge")

