[node name="SeasonPilotCard" type="Panel"]
auto_translate_mode = 2
editor_description = "Small vertical pilot card (season hub roster row · week screen row under the map · detail sheet head · own PREP card, five in seat order). No card background (SeasonPilotCardBare = empty box, 2026-10): portrait and gauges sit on the page. Width comes from the row (expand), height fixed here. Portrait in the progress ring (깨달음 level EXP bar, TrainingLevel.progress) on top with the level chip at its bottom-left, then two gauges (%Gauges: stress · trust, PilotGauge; each gauge shows its value under the ring (stress number, trust %) and, on the week screen, today's change on the ring + (+N) / (+N%) under the value; the portrait ring shows the day's level EXP as a light segment). No position badge (removed 2026-10; seat order says the role). Tap = pressed(pilot_id) → SeasonPilotDetail."
custom_minimum_size = Vector2(0, 244)
offset_right = 190.0
offset_bottom = 244.0
mouse_filter = 2
theme = ExtResource("2_theme")
theme_type_variation = &"SeasonPilotCardBare"
script = ExtResource("1_script")

[node name="Ring" type="Control" parent="."]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — SeasonPilotCard.gd show_pilot() · show_empty() · set_day_deltas()
ProgressRing: track + arc of the 깨달음 level EXP bar (TrainingLevel.progress; code paints LINK, ACCENT while capped = limit break due / max) + the day's EXP as a light segment (week screen)."
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -70.0
offset_top = 12.0
offset_right = 70.0
offset_bottom = 152.0
grow_horizontal = 2
mouse_filter = 2
script = ExtResource("4_ring")

[node name="Portrait" type="Control" parent="Ring"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — SeasonPilotCard.gd _draw_portrait()
Slot for the round portrait (code draws OutgameTheme.add_round_portrait here, diameter = this slot's width), inset inside the ring."
anchors_preset = 0
offset_left = 12.0
offset_top = 12.0
offset_right = 128.0
offset_bottom = 128.0
mouse_filter = 2

[node name="LevelChip" type="Panel" parent="."]
