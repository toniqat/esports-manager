[node name="SeasonPilotCard" type="Panel"]
auto_translate_mode = 2
editor_description = "Small vertical pilot card (season hub roster row · week screen bottom row, five in seat order). Width comes from the row (expand), height fixed here. Badge on top, portrait in the trust ring with the trust pill at its bottom-right, stress line, emphasised note line. Tap = pressed(pilot_id) → SeasonPilotDetail."
