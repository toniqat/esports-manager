[node name="PilotGauge_Stress" parent="Gauges" instance=ExtResource("3_gauge")]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — SeasonPilotCard.gd show_pilot() · show_empty()
Stress: band-coloured icon, ring = 0..100 + overflow lap to STRESS_MAX, the value under it; week screen: today's change as a ring segment + (+N) / (-N) under the value (set_day_deltas)."
layout_mode = 2

[node name="PilotGauge_Trust" parent="Gauges" instance=ExtResource("3_gauge")]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — SeasonPilotCard.gd show_pilot() · show_empty()
Trust: pink heart with the level inside, ring = progress inside the level, the progress % under it; week screen: today's change (+N%, set_day_deltas)."
layout_mode = 2

