[node name="SeasonPilotCard" type="Panel"]
auto_translate_mode = 2
editor_description = "Small vertical pilot card (season hub roster row · week screen bottom row, five in seat order). Width comes from the row (expand), height fixed here. Portrait in the trust ring (level progress) on top with the trust level pill at its bottom-right, then three gauge panels (%Gauges: stress · trust · awakening, PilotGauge), then the emphasised note line. No position badge (removed 2026-10; seat order says the role). Tap = pressed(pilot_id) → SeasonPilotDetail."
custom_minimum_size = Vector2(0, 256)
offset_right = 190.0
offset_bottom = 256.0
mouse_filter = 2
theme = ExtResource("2_theme")
theme_type_variation = &"Card"
script = ExtResource("1_script")

