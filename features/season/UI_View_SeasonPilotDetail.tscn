[node name="SeasonPilotDetail" type="VBoxContainer"]
editor_description = "Pilot detail sheet body (SeasonPilotDetail.open → HubSheet body, title = pilot name). Top-wide, 16 short of the body width (scroll-bar room); the sheet's scroll height follows this node's height. Stat names are full names (no short forms)."
