[node name="AwakeningPilotBlock" type="VBoxContainer"]
editor_description = "Awakening gauge + card presets of one pilot, mounted by SeasonPilotDetail into %AwakeningSlot (AwakeningPilotBlock.mount). Top-wide; height = content."
