[node name="ResearchBubble" type="Control"]
auto_translate_mode = 2
editor_description = "Facility research speech bubble on a team base map (BaseMap %Facilities, one per Spot_Fac_* marker). The tail tip (TailTip) stands on the facility spot. Shows the facility name, the active research icon masked to a circle as a radial progress bar (research_ring.gdshader), and the percentage; idle states (vacant · no research · paused) grey the icon and replace the percentage. Hub: tappable (%Hit, also covers the spot under the tail) → FacilitySheet. Week screen: read-only."
custom_minimum_size = Vector2(104, 150)
layout_mode = 3
anchors_preset = 0
offset_right = 104.0
offset_bottom = 150.0
mouse_filter = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

