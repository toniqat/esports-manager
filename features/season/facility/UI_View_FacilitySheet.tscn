[node name="FacilitySheet" type="VBoxContainer"]
editor_description = "Facility sheet body (HubSheet, FacilitySheet.open(host, fid)): head (icon ring · desc · stat · weekly points) · level + two-step upgrade · occupant picker · research list + target picker · the kind handler's body (%KindSlot). Code fills the % nodes and the lists (sample rows are previews, cleared in _ready)."
anchors_preset = 10
anchor_right = 1.0
offset_right = -24.0
grow_horizontal = 2
mouse_filter = 2
theme = ExtResource("1_theme")
theme_override_constants/separation = 0
script = ExtResource("2_script")

[node name="Head" type="HBoxContainer" parent="."]
custom_minimum_size = Vector2(0, 128)
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

