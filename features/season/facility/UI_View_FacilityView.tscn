[node name="FacilityView" type="Control"]
editor_description = "Facility screen (SeasonHub Screen.FACILITY, FacilityView.gd): header = facility icon · name · status line, occupant button (portrait + the facility stat, opens OccupantPicker), level + upgrade (lit only when FacilitySystem.can_upgrade; ConfirmPopup). %BodySlot holds the kind body (ResearchSystem.make_body, full rect — the screen itself never scrolls). Bottom bar: the body's optional action (left) + back to the hub (right)."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
