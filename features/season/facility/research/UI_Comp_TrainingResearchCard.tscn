[node name="TrainingResearchCard" type="PanelContainer"]
editor_description = "One research card of a training facility body (TrainingResearchBody %Grid, 3 columns): the course thumbnail in the training-board card look (tap = info popover), a status line, and the progress bar split into one segment per research week. Code switches SelectableCard / SelectableCardOn (active row) and fades %Content for a level-locked row."
custom_minimum_size = Vector2(0, 322)
offset_right = 312.0
offset_bottom = 322.0
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"SelectableCard"
script = ExtResource("1_script")

[node name="Hit" type="Button" parent="."]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — TrainingResearchCard.gd _ready() · fill()
Whole-card tap target = select this research (HUB only; disabled otherwise or when the facility level is too low)."
layout_mode = 2
focus_mode = 0
flat = true

[node name="Content" type="MarginContainer" parent="."]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류 — TrainingResearchCard.gd fill()
Faded (modulate) when the facility level is below the row's min level."
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
