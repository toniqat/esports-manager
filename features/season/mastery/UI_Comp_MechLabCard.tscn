[node name="MechLabCard" type="Button"]
editor_description = "One research target of the mech lab (MechLabBody %Grid, 3 columns): tap = research this mech (HUB only, disabled otherwise). Variation SelectableCardButton / SelectableCardButtonOn (= the lab's active mech) is switched by code. Mech art · name · role badge · progress % + bar, then up to 3 suggested pilots (MechResearch.fit_pilots). Height fixed here: 4.5 rows (+ gaps) fill the ~1440 px body slot on 1080x1920."
custom_minimum_size = Vector2(0, 300)
offset_right = 320.0
offset_bottom = 300.0
size_flags_horizontal = 3
focus_mode = 0
mouse_filter = 1
theme = ExtResource("1_theme")
theme_type_variation = &"SelectableCardButton"

