[node name="PersonnelBody" type="VBoxContainer"]
editor_description = "Personnel office body (FacilityView %BodySlot, PersonnelResearch.make_body). Top: run staff as StaffThumb cards (3 columns, ~2.5 rows visible, scrolls inside). Bottom: scouted candidates (3 columns, takes the rest, scrolls inside) with the scouting gauge on its header line. Tap a card = confirm popup (dismiss / hire). Sample cards are previews (cleared in _ready)."
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("1_theme")
theme_override_constants/separation = 0
script = ExtResource("2_script")

