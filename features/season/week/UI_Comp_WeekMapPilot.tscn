[node name="WeekMapPilot" type="Control"]
auto_translate_mode = 2
editor_description = "One of my pilots on the base map (BaseMap %Tokens). The portrait centre stands on the spot. No name under the portrait. Morning: a speech bubble over the portrait names that day's training (%Bubble). After Next the day's results rise out of the portrait top and fade (%Floats, duplicates of %FloatLine). Afternoon: %Away names an away state (혼자 외출 / 숙소 휴식); code dims the whole token (modulate) when the pilot cannot be asked."
custom_minimum_size = Vector2(136, 120)
layout_mode = 3
anchors_preset = 0
offset_right = 136.0
offset_bottom = 120.0
mouse_filter = 2
theme = ExtResource("1_theme")

