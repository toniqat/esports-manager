[node name="WeekTalkCard" type="Panel"]
editor_description = "오전 만남 (Mon–Fri, after the training result, before the talk): the pilot picked on the base map, then 만남. Without a pick %Pilot is hidden (%Hint only says when nobody can be met). A pilot who trained in the same tile with others brings one along (%With). Next in the bottom bar moves on to the afternoon (with a warning while a talk is still possible)."
