[node name="Root" type="Control" parent="."]
auto_translate_mode = 2
editor_description = "Afternoon visit (방문) menu of the week screen: a speech bubble over the visited pilot's map token (집중 훈련 / 이야기 / 외출), then the focus training modal centred on screen (courses → result). Full rect STOP: swallows every other tap while open (no dim — the map stays visible). Every text is code-filled (auto_translate_mode = 2)."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Bubble" type="PanelContainer" parent="Root"]
