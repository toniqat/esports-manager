[node name="Root" type="Control" parent="."]
auto_translate_mode = 2
editor_description = "Afternoon visit (방문) menu of the week screen, a speech bubble over the visited pilot's map token: menu page (집중 훈련 / 이야기 / 외출) → courses page → result page. Full rect STOP: swallows every other tap while open (no dim — the map stays visible). Every text is code-filled (auto_translate_mode = 2)."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Bubble" type="PanelContainer" parent="Root"]
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류: VisitMenu.gd _show_page() · _place_bubble()
The speech bubble (VisitMenuBubble). Code places it above the token's portrait (or under the token when it does not fit), clamped inside the safe area; its height follows the page."
