[node name="FloatingBarButton_Action" parent="SafeArea/Bar" instance=ExtResource("fbb_scene")]
auto_translate_mode = 2
unique_name_in_owner = true
editor_description = "[필수] 지우면 오류: WeekProgressView.gd _action_btn
Primary bar slot. Training day: 다음 (morning: settle the day, result: to the afternoon, afternoon: next day, with a warning while an action is still possible). Match day: 확인 / 주 마감 → (BarPrimaryButton) or 경기 시작 (BarDarkButton); code clears stale overrides after switching (fit_bar_button)."
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.0
focus_mode = 0
theme_type_variation = &"BarPrimaryButton"
text = "다음"
