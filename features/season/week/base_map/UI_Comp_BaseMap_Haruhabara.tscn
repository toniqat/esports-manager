[node name="BaseMap_Haruhabara" type="Control"]
editor_description = "Team base map (BaseMap.gd). Drag the Spots/Spot_* markers onto the buildings; pilots stand on the spot of their training colour (morning) or on Dorm / Entrance (afternoon away). Art is a prototype placeholder, see resources/images/base_map/README.md."
custom_minimum_size = Vector2(1200, 761)
layout_mode = 3
anchors_preset = 0
offset_right = 1200.0
offset_bottom = 761.0
mouse_filter = 2
script = ExtResource("1_map")

[node name="Art" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_art")
expand_mode = 1
stretch_mode = 5

[node name="Lighting" type="Control" parent="."]
editor_description = "Time-of-day lighting (BaseMapLighting): code adds a lit copy of Art + the normal / shadow views (never saved). Scrub `hour` in the inspector to preview the sun; the building shapes are under Buildings."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("9_light")
noon_azimuth_deg = 70.0

[node name="Spots" type="Control" parent="."]
