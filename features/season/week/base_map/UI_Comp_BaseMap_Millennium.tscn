[node name="BaseMap_Millennium" type="Control"]
editor_description = "Team base map (BaseMap.gd). Drag the Spots/Spot_* markers onto the buildings; pilots stand on the spot of their training colour (morning) or on Dorm / Entrance (afternoon away). Art is a prototype placeholder, see resources/images/base_map/README.md."
custom_minimum_size = Vector2(1200, 761)
layout_mode = 3
anchors_preset = 0
offset_right = 1200.0
offset_bottom = 761.0
mouse_filter = 2
script = ExtResource("1_map")

