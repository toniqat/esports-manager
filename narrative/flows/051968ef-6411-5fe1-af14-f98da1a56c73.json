        "87dfaad7-1389-5c46-8e6a-3fb4c22bc789": -1,
        "79aa4e02-5302-536a-a8a1-b151801d2c1b": 0,
        "4bdc6cef-afd0-5610-acc2-eac64116d76f": "train=C,D",
        "7c34138a-ca3a-5730-9f61-685298543931": 2
      }
    },
    {
      "id": "ae00e368-31c0-5b10-946a-3a4e1b499fac",
      "type": "Select",
      "name": "Select",
      "localId": 5,
      "x": 640,
      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "852b4231-9e76-5982-9c5a-70d82f7f2a63",
          "text": "내가 보기엔 판단은 좋았어.",
          "sharedValues": {
            "7c2094a4-88e9-5f90-9af5-be7997ebcc99": "trust:+2;stress:-3"
          }
        },
        {
          "id": "b73f9ef3-fac8-5cc5-a294-bff756c8354d",
          "text": "늦은 이유를 같이 짚어 보자.",
          "sharedValues": {
            "7c2094a4-88e9-5f90-9af5-be7997ebcc99": "ok>pmod:engage_hit:+1:-1;ok>trust:+1;ng>stress:+2"
          }
        }
      ],
      "translations": {
        "opt:852b4231-9e76-5982-9c5a-70d82f7f2a63": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "From where I stood, your decisions were good.",
            "status": "progress"
          }
        },
        "opt:b73f9ef3-fac8-5cc5-a294-bff756c8354d": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Let's work out together why you were late.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "913cba8c-d006-53f1-8216-69c2eb9ded54",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 6,
      "x": 940,
      "y": -90.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "그래요? 조금 안심이 되네요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Really? That's a bit of a relief.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "99476b54-2e73-52ec-a2c2-ede5b1c503cf",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 940,
      "y": 170.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "아, 시야를 너무 좁게 봤던 거군요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Ah, I was keeping my view too narrow.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "aedfa7d9-4bfe-5a40-a853-44e04c356093": "ok"
      }
    },
    {
      "id": "fb2d9e3b-e7a8-5064-8b33-5de1e3286f2a",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1240,
      "y": 170.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "음… 잘 모르겠어요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Hmm... I'm not sure.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "aedfa7d9-4bfe-5a40-a853-44e04c356093": "ng"
      }
    }
  ],
