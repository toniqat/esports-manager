            "1889736d-a2d1-5554-93c1-39de13c9563f": "trust:+3"
          }
        },
        {
          "id": "82cee4e6-c19e-5791-bef3-645cce483c00",
          "text": "한 메크에 너무 매이지는 마.",
          "sharedValues": {
            "1889736d-a2d1-5554-93c1-39de13c9563f": "stress:-2"
          }
        }
      ],
      "translations": {
        "opt:7cd2ac08-3698-59b2-876c-86753bf77cbb": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Good. Let's prepare the next match with that mech.",
            "status": "progress"
          }
        },
        "opt:82cee4e6-c19e-5791-bef3-645cce483c00": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Don't get too tied to one mech.",
            "status": "progress"
          }
        }
      }
    },
    {
