      "content": "솔직히… 좀 지쳤어요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Honestly… I'm a bit worn out.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "264e4c64-8b7c-5989-8b6a-445f8e07d71c",
