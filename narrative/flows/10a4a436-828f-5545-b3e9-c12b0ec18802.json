      "color": "#64748b",
      "options": [
        {
          "id": "73f25c36-7bb2-5243-afb8-5821b767d83f",
          "text": "조금만 더 버텨 보자. 오늘 배운 걸 굳히자.",
          "sharedValues": {
            "ce6c1775-766a-5f59-9f5f-db537a55770e": "train_bonus:std;stress:+12;ok>trust:+2;ng>trust:-3"
          }
        },
        {
          "id": "f428f221-f9b3-5e31-93de-63a6f24d80ee",
          "text": "오늘은 다 내려놓고 쉬어.",
          "sharedValues": {
            "ce6c1775-766a-5f59-9f5f-db537a55770e": "stress_train:-2;trust:+3"
          }
        }
      ],
      "translations": {
        "opt:73f25c36-7bb2-5243-afb8-5821b767d83f": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Hang in a little longer. Let's lock in today's lesson.",
            "status": "progress"
          }
        },
        "opt:f428f221-f9b3-5e31-93de-63a6f24d80ee": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Let it all go and rest today.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "e0b0d6ec-0b1f-57b9-92f9-4f8c3504fec1",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 6,
      "x": 940,
      "y": -220,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…알겠어요. 해 볼게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…Got it. I'll try.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "9295cbcc-334b-5e37-8b7d-2932bb079dc7": "ok"
      }
    },
    {
      "id": "4832472a-2605-50e1-aff5-f7bbb6078924",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 1240,
      "y": -220,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "지금은 정말 무리예요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I really can't right now.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "9295cbcc-334b-5e37-8b7d-2932bb079dc7": "ng"
      }
    },
    {
      "id": "d854e77d-4b81-5d55-bc8f-e0d89ba74792",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 940,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "고마워요. 숨 좀 돌릴게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Thanks. I'll catch my breath.",
            "status": "progress"
          }
        }
      }
    }
