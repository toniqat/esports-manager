    {
      "id": "9635bda9-9196-5416-ae06-b8783e21c2b1",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 3,
      "x": 340,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "어제 경기는… 제 탓이에요.\n제가 한타를 망쳤어요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Yesterday's match… that was on me.\nI threw the teamfight.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "99e457bd-d6ee-55ff-b90c-cf81e50bb3d6",
      "type": "Comment",
      "name": "Comment",
      "localId": 4,
      "x": 340,
      "y": -220,
      "color": "#64748b",
      "text": "면담 이벤트 설정",
      "width": 260,
      "height": 110,
      "attachments": [
        {
          "nodeId": "9635bda9-9196-5416-ae06-b8783e21c2b1"
        }
      ],
      "sharedValues": {
        "b9f56aa0-cf50-566c-9eb2-daecf365ffcc": "interview",
        "235291e8-03af-5f7b-a5ce-f91eeae4d328": -1,
        "1e83e936-d5b5-5e9e-9266-051e5984c533": 0,
        "3b455fac-39c4-5cfb-b5bc-ebd911f1dfc9": "last=loss",
        "9600b1c3-6834-5be0-a024-c999e2eefd98": 1
      }
    },
    {
      "id": "18608b21-3e72-5aab-b1ec-a47a205c557e",
      "type": "Select",
      "name": "Select",
      "localId": 5,
      "x": 640,
      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "235a2940-39a2-5ef9-84e9-75e593e76ac4",
          "text": "팀 경기야. 혼자 짊어지지 마.",
          "sharedValues": {
            "91918121-d0d6-5a74-b1fd-281c75dff461": "ok>trust:+6;ng>trust:+2"
          }
        },
        {
          "id": "77f0a8e2-8dc1-5969-918a-9bb60a8b02b0",
          "text": "그래서 다음엔 어떻게 할 건데?",
          "sharedValues": {
            "91918121-d0d6-5a74-b1fd-281c75dff461": "trust:+2;pmod:engage_hit:+2:-1"
          }
        }
      ],
      "translations": {
        "opt:235a2940-39a2-5ef9-84e9-75e593e76ac4": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "It's a team game. Don't carry it alone.",
            "status": "progress"
          }
        },
        "opt:77f0a8e2-8dc1-5969-918a-9bb60a8b02b0": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "So what are you going to do next time?",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "69c19afe-4c6d-58b1-89a8-baeefa988e33",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 6,
      "x": 940,
      "y": -90,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "감독님… 고마워요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Coach… thank you.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "c474a7c4-a48a-5ed6-9855-338d697715ea": "ok"
      }
    },
    {
      "id": "a1fdc8a6-9ec6-5106-9316-d2472e521858",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 1240,
      "y": -90,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "그래도 제 잘못인걸요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Still, it was my fault.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "c474a7c4-a48a-5ed6-9855-338d697715ea": "ng"
      }
    },
    {
      "id": "fd994885-c634-5797-8a8b-64c3f19566f7",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 940,
      "y": 170,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "교전 각을 다시 볼게요. 다음엔 안 놓쳐요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'll rework my engage angles. I won't miss it next time.",
            "status": "progress"
          }
        }
      }
    }
  ],
