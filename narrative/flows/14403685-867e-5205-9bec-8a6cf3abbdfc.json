      "content": "오늘은 아무것도 안 는 것 같아요…",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Feels like nothing improved today…",
            "status": "progress"
          }
        }
      }
    },
    {
