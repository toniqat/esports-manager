      "localId": 4,
      "x": 340,
      "y": -220,
      "color": "#64748b",
      "text": "이야기 이벤트 설정",
      "width": 260,
      "height": 110,
      "attachments": [
        {
          "nodeId": "e3c53a1b-35cf-53ff-9c1c-2e6f5d1f44a8"
