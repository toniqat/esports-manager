      "color": "#64748b",
      "options": [
        {
          "id": "7881a8fd-6151-560f-b95b-5fb8a365eec9",
          "text": "그럴 때일수록 한 번 더. 같이 하자.",
          "sharedValues": {
            "7ce5cd08-1e56-584c-a7bf-2aa0c0b3f89b": "train_bonus:std;stress:+8;trust:+2"
          }
        },
        {
          "id": "490e7dab-e15f-500a-8501-89dd0af03294",
          "text": "정체기는 누구나 와. 오늘은 쉬자.",
          "sharedValues": {
            "7ce5cd08-1e56-584c-a7bf-2aa0c0b3f89b": "stress_train:-2;awaken:+5"
          }
        }
      ],
      "translations": {
        "opt:7881a8fd-6151-560f-b95b-5fb8a365eec9": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "That's exactly when we do one more. Together.",
            "status": "progress"
          }
        },
        "opt:490e7dab-e15f-500a-8501-89dd0af03294": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Everyone hits a plateau. Let's rest today.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "b813ea20-6d05-5d9e-9837-acca58477610",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 6,
      "x": 940,
      "y": -220,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…감독님이 같이 해 주시면요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…If you're with me, Coach.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "8598517b-7c90-53d6-b271-48c2522feae3",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 940,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "그렇게 말해 주시니 좀 편하네요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Hearing that makes me feel better.",
            "status": "progress"
          }
        }
      }
    }
