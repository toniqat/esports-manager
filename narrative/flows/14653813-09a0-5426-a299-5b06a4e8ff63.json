        {
          "id": "71d18ee8-3a60-5e87-bdce-ae9b50b6de1e",
          "text": "서로 끌어 주는 게 보기 좋다.",
          "sharedValues": {
            "8feec493-2df3-55c3-91f6-540b69a34a49": "trust:+3"
          }
        },
        {
          "id": "ab50e01e-0b41-5ef3-8254-2e2ecbda3f8b",
          "text": "{name2}, 너도 질 수 없겠는데?",
          "sharedValues": {
            "8feec493-2df3-55c3-91f6-540b69a34a49": "ok>pmod:all:+1:-1;ng>stress:+3"
          }
        }
      ],
      "translations": {
        "opt:71d18ee8-3a60-5e87-bdce-ae9b50b6de1e": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "It's good to see you pulling each other up.",
            "status": "progress"
          }
        },
        "opt:ab50e01e-0b41-5ef3-8254-2e2ecbda3f8b": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "{name2}, you can't fall behind either, right?",
            "status": "progress"
          }
        }
      }
    },
    {
