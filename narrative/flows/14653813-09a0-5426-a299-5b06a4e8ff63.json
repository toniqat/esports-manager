      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "야, 그런 말을 왜 네가 해.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Hey, why are you the one saying that.",
            "status": "progress"
          }
        }
      }
    },
