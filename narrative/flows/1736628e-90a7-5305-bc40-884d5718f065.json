        {
          "id": "eb0f446f-044a-5520-8d18-c5b6548300ea",
          "text": "제 준비가 부족했습니다.",
          "sharedValues": {
            "7428e65f-aae7-5dc3-b7d6-18a43d34e22f": "trust_all:+2;smod:mental:-1:1"
          }
        },
        {
          "id": "d44448dc-2096-50c3-b805-2f96a88faebf",
          "text": "선수들 컨디션이 안 좋았습니다.",
          "sharedValues": {
            "7428e65f-aae7-5dc3-b7d6-18a43d34e22f": "trust_all:-2"
          }
        },
        {
          "id": "603d1baf-f549-5dd3-b4f7-ffb93c5b804b",
          "text": "지나간 경기는 잊었습니다.",
          "sharedValues": {
            "7428e65f-aae7-5dc3-b7d6-18a43d34e22f": "ok>smod:mental:+1:1;ng>trust_all:-1"
          }
        }
      ],
      "translations": {
        "opt:eb0f446f-044a-5520-8d18-c5b6548300ea": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I didn't prepare enough.",
            "status": "progress"
          }
        },
        "opt:d44448dc-2096-50c3-b805-2f96a88faebf": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "The players weren't in good shape.",
            "status": "progress"
          }
        },
        "opt:603d1baf-f549-5dd3-b4f7-ffb93c5b804b": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I've already forgotten about that match.",
