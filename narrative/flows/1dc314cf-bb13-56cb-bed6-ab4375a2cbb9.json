      "options": [
        {
          "id": "d39437ac-4a25-53a6-91a1-b88d445db7f8",
          "text": "자주 오자.",
          "sharedValues": {
            "09e04f13-ff6f-5e78-a8f7-d278998cbb4a": "trust:+5;pmod:all:+1:-1"
          }
        },
        {
          "id": "0aea5607-3a42-5d94-8235-a6414630fb97",
          "text": "맛있게 먹어. 오늘은 내가 산다.",
          "sharedValues": {
            "09e04f13-ff6f-5e78-a8f7-d278998cbb4a": "trust:+4;pmod:all:+1:-1"
          }
        }
      ],
      "translations": {
        "opt:d39437ac-4a25-53a6-91a1-b88d445db7f8": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Let's come here more often.",
            "status": "progress"
          }
        },
        "opt:0aea5607-3a42-5d94-8235-a6414630fb97": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Enjoy. It's on me tonight.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "129b0d31-face-5b2c-be26-a40af7403fc6",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 1240,
      "y": -90,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "정말요? 약속이에요!",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Really? That's a promise!",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "0a14ee55-22f5-581f-89c2-eec055356418",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
