      "color": "#64748b",
      "options": [
        {
          "id": "5293a01a-e79f-5728-ba4f-3b2c8d9305c6",
          "text": "괜찮아. 오늘은 여기까지 하자.",
          "sharedValues": {
            "461edc57-ebc0-5c95-8948-59a07e912ca3": "stress:-8;trust:+2"
          }
        },
        {
          "id": "cf7bf1be-56a2-5aa7-a421-6ad0c670846b",
          "text": "힘든 거 알아. 그래도 조금만 더 버텨.",
          "sharedValues": {
            "461edc57-ebc0-5c95-8948-59a07e912ca3": "ok>trust:+2;ok>pmod:all:+1:-1;ng>stress:+6;ng>trust:-3"
          }
        }
      ],
      "translations": {
        "opt:5293a01a-e79f-5728-ba4f-3b2c8d9305c6": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "It's fine. Let's call it a day.",
            "status": "progress"
          }
        },
        "opt:cf7bf1be-56a2-5aa7-a421-6ad0c670846b": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I know it's hard. Hang in there a little longer.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "7f529b7b-f673-547a-8bde-11e5422bf7a5",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 1240,
      "y": -90,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…고마워요, 감독님.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "...Thank you, Coach.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "d24d4ef5-3d04-5554-bc32-bb49d8f5d5a7",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1240,
      "y": 170,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "네… 버틸게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Yes... I'll hang in there.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "062cc341-2fc4-5963-b665-c42edcd11fb2": "ok"
      }
    },
    {
      "id": "968f94b0-5f02-5fb3-a23c-02368f28cd74",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 9,
      "x": 1540,
      "y": 170,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "저 지금 진짜 한계예요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'm really at my limit right now.",
            "status": "progress"
          }
        }
      },
