      "color": "#64748b",
      "options": [
        {
          "id": "307827a6-a05e-5c3b-9482-470f0c7f2bce",
          "text": "하루 다녀와. 훈련은 걱정 마.",
          "sharedValues": {
            "6ff02439-e445-572d-9a87-b6b7b3a9cdd6": "trust:+6;pmod:all:-1:1"
          }
        },
        {
          "id": "7bde67f6-1f14-56f5-a85f-1916f64a4cb7",
          "text": "시즌 끝나고 꼭 보내 줄게.",
          "sharedValues": {
            "6ff02439-e445-572d-9a87-b6b7b3a9cdd6": "ok>trust:+2;ng>trust:-3"
          }
        }
      ],
      "translations": {
        "opt:307827a6-a05e-5c3b-9482-470f0c7f2bce": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Go for a day. Don't worry about practice.",
            "status": "progress"
          }
        },
        "opt:7bde67f6-1f14-56f5-a85f-1916f64a4cb7": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'll make sure you go once the season's over.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "64ba76b0-660f-5ac0-9a69-0c5d1cf15d88",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1540,
      "y": -90,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "고마워요 감독님!",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Thank you, Coach!",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "c4bcfe70-e2d9-5867-a989-62210cf3b74d",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 9,
      "x": 1540,
      "y": 170,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…네. 약속이에요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…Okay. That's a promise.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "17db98ec-c6d7-547a-9ba6-5d2679e64d9a": "ok"
      }
    },
    {
      "id": "052fe39f-78b9-5ffe-9b2c-45cd2ae6201d",
      "type": "Dialog",
      "name": "Dialog",
