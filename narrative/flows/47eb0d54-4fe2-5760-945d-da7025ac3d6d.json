      "content": "{name} 선수가 밤늦게 가족과 통화하며 울고 있었다.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "{name} was crying on the phone with family late at night.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "ed47f189-cb53-5744-aca3-b24e17bd62a3",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 5,
      "x": 940,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "집에 한 번만 다녀오면 안 될까요?",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Could I go home just once?",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "b1db8ad0-d43f-5d6a-8f94-13d45a36272a",
      "type": "Comment",
