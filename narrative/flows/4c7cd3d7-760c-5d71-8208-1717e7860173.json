        {
          "id": "7f107e2d-846e-5ee1-8924-e7a51aed17f8",
          "text": "여기서부터 여기까지 왔구나.",
          "sharedValues": {
            "99d6b2e0-5ea2-5342-b919-8497255015fc": "trust:+7;pmod:all:+2:-1"
          }
        },
        {
          "id": "b9906927-baec-5efb-b4e7-964374e95b26",
          "text": "들어가 볼까?",
          "sharedValues": {
            "99d6b2e0-5ea2-5342-b919-8497255015fc": "trust:+7;pmod:all:+2:-1"
          }
        }
      ],
      "translations": {
        "opt:7f107e2d-846e-5ee1-8924-e7a51aed17f8": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "So this is where it all started.",
            "status": "progress"
          }
        },
        "opt:b9906927-baec-5efb-b4e7-964374e95b26": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Want to go in?",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "c85d8456-e8ff-5ed6-be7e-c31b5cb34c4f",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
