      "y": 40,
      "color": "#64748b",
      "speakerId": "84ab847b-1bad-5351-8718-5cf62bff28a4",
      "content": "승리의 가장 큰 원동력은 무엇이었습니까?",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "What was the biggest driver of the win?",
            "status": "progress"
          }
        }
      }
    },
