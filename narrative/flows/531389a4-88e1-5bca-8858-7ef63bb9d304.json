        {
          "id": "c3c19241-638e-55e8-90f3-386af214845d",
          "text": "선수들이 준비한 걸 그대로 보여 줬습니다.",
          "sharedValues": {
            "1f4847f4-b531-53f3-aa74-be1cb4bc96c5": "trust_all:+2"
          }
        },
        {
          "id": "e8c8c7ef-630c-5fff-a5f5-78f0f6d6b882",
          "text": "밴픽에서 이미 이겼다고 봅니다.",
          "sharedValues": {
            "1f4847f4-b531-53f3-aa74-be1cb4bc96c5": "smod:tactics:+1:1"
          }
        },
        {
          "id": "20671312-9e47-5851-b865-247408698619",
          "text": "아직 보완할 점이 많습니다.",
          "sharedValues": {
            "1f4847f4-b531-53f3-aa74-be1cb4bc96c5": "ok>smod:mental:+1:1;ng>trust_all:-1"
          }
        }
      ],
      "translations": {
        "opt:c3c19241-638e-55e8-90f3-386af214845d": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "The players showed exactly what we prepared.",
            "status": "progress"
          }
        },
        "opt:e8c8c7ef-630c-5fff-a5f5-78f0f6d6b882": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I think we had already won at ban/pick.",
            "status": "progress"
          }
        },
        "opt:20671312-9e47-5851-b865-247408698619": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "We still have a lot to work on.",
            "status": "progress"
          }
        }
