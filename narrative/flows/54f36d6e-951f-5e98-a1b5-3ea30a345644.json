      "options": [
        {
          "id": "dbcdab4a-0173-5869-a963-d4aa7a62ceda",
          "text": "내일은 변칙 동선도 섞어 볼까?",
          "sharedValues": {
            "ce833c62-9bb6-5bfa-943a-a977f1d65bf7": "trust:+2;stress:-2"
          }
        },
        {
          "id": "da7c11e8-e8c8-58b8-a172-95dace634f6f",
          "text": "기본이 제일 중요해. 그대로 가자.",
          "sharedValues": {
            "ce833c62-9bb6-5bfa-943a-a977f1d65bf7": "ok>pmod:field_hit:+1:-1;ng>stress:+2"
          }
        }
      ],
      "translations": {
        "opt:dbcdab4a-0173-5869-a963-d4aa7a62ceda": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Want to mix in some unusual routes tomorrow?",
            "status": "progress"
          }
        },
        "opt:da7c11e8-e8c8-58b8-a172-95dace634f6f": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Basics matter most. Keep it as is.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "b6ee2fa0-5419-51ac-8271-61480c248332",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
