        {
          "id": "2bdfa326-05ce-5ac8-904d-90e7bd30c422",
          "text": "{name}{eun} 우리 팀의 기둥입니다.",
          "sharedValues": {
            "0da657e7-da84-5f68-8973-b2fd3ec2867f": "trust:+4"
          }
        },
        {
          "id": "f031f4ee-efd8-5e1d-b2ee-f2cc732596f9",
          "text": "한 경기 잘한 걸로는 부족합니다.",
          "sharedValues": {
            "0da657e7-da84-5f68-8973-b2fd3ec2867f": "ok>trust:+1;ng>trust:-3"
          }
        },
        {
          "id": "2480ac8b-c2a7-55a3-b75e-eba1cef87fba",
          "text": "MVP는 팀 전체가 받은 겁니다.",
          "sharedValues": {
            "0da657e7-da84-5f68-8973-b2fd3ec2867f": "trust:-1;trust_all:+1"
          }
        }
      ],
      "translations": {
        "opt:2bdfa326-05ce-5ac8-904d-90e7bd30c422": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "{name} is the backbone of this team.",
            "status": "progress"
          }
        },
        "opt:f031f4ee-efd8-5e1d-b2ee-f2cc732596f9": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "One good match isn't enough.",
            "status": "progress"
          }
        },
        "opt:2480ac8b-c2a7-55a3-b75e-eba1cef87fba": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
