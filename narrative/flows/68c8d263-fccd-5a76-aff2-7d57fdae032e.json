      "x": 340,
      "y": -220,
      "color": "#64748b",
      "text": "면담 이벤트 설정",
      "width": 260,
      "height": 110,
      "attachments": [
        {
          "nodeId": "f1ca89e4-7455-5d04-86dd-c8ce7210db45"
        }
      ],
