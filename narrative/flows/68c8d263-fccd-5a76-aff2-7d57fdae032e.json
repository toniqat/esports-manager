      "color": "#64748b",
      "speakerId": null,
      "content": "{name} 선수가 시선을 피한다.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "{name} avoids your eyes.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "640bb08d-3788-5644-98b8-d404f33599d9",
      "type": "Comment",
