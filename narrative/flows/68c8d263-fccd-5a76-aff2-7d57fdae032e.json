        "2762fe81-0d33-524b-b720-ec383f1aa4c5": -1,
        "903f361a-a53e-5b67-915f-ed2e25b4ad4c": 0,
        "4591e679-12e0-58f6-acdf-fbc2c1a52c0e": "trust<25",
        "33dd0082-07bb-5a3a-b811-2fd6ce2f040b": 1
      }
    },
    {
      "id": "7e87eb91-0693-5bfd-97ae-df4fe58efbba",
      "type": "Select",
      "name": "Select",
      "localId": 6,
      "x": 940,
      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "d88cf4f9-bbcf-5ae3-a9ae-400dd6b17808",
          "text": "요즘 어떻게 지내나 해서.",
          "sharedValues": {
            "c96c241b-2d14-573d-b20c-a830cd1c0ef0": "trust:+3"
          }
        },
        {
          "id": "a0645ab8-edec-51eb-a635-4fa18035fc7a",
          "text": "내가 뭐 서운하게 한 거 있어?",
          "sharedValues": {
            "c96c241b-2d14-573d-b20c-a830cd1c0ef0": "ok>trust:+7"
          }
        },
        {
          "id": "512e87a0-c013-58da-98b9-a11ec3c6746d",
          "text": "훈련 태도가 좀 아쉬워.",
          "sharedValues": {
            "c96c241b-2d14-573d-b20c-a830cd1c0ef0": "ok>trust:+1;ng>trust:-4"
          }
        }
      ],
      "translations": {
        "opt:d88cf4f9-bbcf-5ae3-a9ae-400dd6b17808": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Just checking how you've been.",
            "status": "progress"
          }
        },
        "opt:a0645ab8-edec-51eb-a635-4fa18035fc7a": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Did I do something to upset you?",
            "status": "progress"
          }
        },
        "opt:512e87a0-c013-58da-98b9-a11ec3c6746d": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Your attitude in practice has been a bit off.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "ca78f9e9-fd36-55ab-a2ab-abfba95cd714",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 1240,
      "y": -220.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "그냥 그래요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Same as always.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "2c117184-5486-59ff-a52c-078265a93cc1",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1240,
      "y": 40.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…사실 좀 있었어요. 말해도 돼요?",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…Actually, there was something. Can I tell you?",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "02f451a9-a6a7-5902-b577-291adf428c3b": "ok"
      }
    },
    {
      "id": "64b8da61-c397-543f-98fc-b8cf207f8fcb",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 9,
      "x": 1540,
      "y": 40.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "없어요. 괜찮아요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "No. I'm fine.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "02f451a9-a6a7-5902-b577-291adf428c3b": "ng"
      }
    },
    {
      "id": "1c82d304-5a96-59e6-9c78-9ddae4459aac",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 10,
      "x": 1240,
      "y": 300.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…고칠게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…I'll fix it.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "02f451a9-a6a7-5902-b577-291adf428c3b": "ok"
      }
    },
    {
      "id": "5000be2c-ffad-5902-8cbf-78bb00c7f70d",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 11,
      "x": 1540,
      "y": 300.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "(대답이 없다)",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "(No answer.)",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "02f451a9-a6a7-5902-b577-291adf428c3b": "ng"
      }
    }
