    {
      "id": "527083a2-6fa3-5c1b-b233-efc610f83594",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 3,
      "x": 340,
      "y": 40,
      "color": "#64748b",
      "speakerId": null,
      "content": "늦은 밤 옥상. {name} 선수가 먼저 와 있었다.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "The rooftop, late at night. {name} got there first.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "bb821739-07a2-52a3-be21-67490125aeb6",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 4,
      "x": 640,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "감독님. 저 이번 시즌 끝나면 꼭 하고 싶은 말이 있어요.\n…지금 말하면 반칙이니까 우승하고 할게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Coach. There's something I really want to tell you when this season's over.\n…Saying it now would be cheating, so I'll tell you after we win.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "56e30d62-c617-57db-a312-337c8240fe7f",
      "type": "Comment",
      "name": "Comment",
      "localId": 5,
      "x": 340,
      "y": -220,
      "color": "#64748b",
      "text": "외출 이벤트 설정",
      "width": 260,
      "height": 110,
      "attachments": [
        {
          "nodeId": "527083a2-6fa3-5c1b-b233-efc610f83594"
        }
      ],
      "sharedValues": {
        "8656ce14-3e8d-57a9-8fa4-62844097a261": "outing",
        "9b53d358-05e1-515d-aa79-f0cf601eeb51": -1,
        "19c99c72-90f5-52fa-ba40-a4c3a7ea908a": 5,
        "3191a68e-2625-5865-8378-da05320a9b96": "",
        "2da8ae53-f378-5f90-960d-b47cf656622f": 1
      }
    },
    {
      "id": "06d84c12-5e1e-5398-bbf6-85c72bb9707f",
      "type": "Select",
      "name": "Select",
      "localId": 6,
      "x": 940,
      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "ee4b3935-0e42-529c-9370-c1140013ac2e",
          "text": "그럼 꼭 우승해야겠네.",
          "sharedValues": {
            "2c3ad887-f65c-55d3-a4c4-a45ddf5236ce": "trust:+8;pmod:all:+2:-1"
          }
        },
        {
          "id": "d9bb47f6-30ed-5555-bed5-98c923e60797",
          "text": "기다릴게.",
          "sharedValues": {
            "2c3ad887-f65c-55d3-a4c4-a45ddf5236ce": "trust:+8;pmod:all:+2:-1"
          }
        }
      ],
      "translations": {
        "opt:ee4b3935-0e42-529c-9370-c1140013ac2e": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Then we'd better win.",
            "status": "progress"
          }
        },
        "opt:d9bb47f6-30ed-5555-bed5-98c923e60797": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'll be waiting.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "d43eab2b-18c7-5b73-8d16-2ff966bc1a54",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 1240,
      "y": -90,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "약속이에요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "It's a promise.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "01ea888f-6b24-578f-b83e-15f7c403aa33",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1240,
      "y": 170,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "네. 꼭이요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Yeah. For sure.",
            "status": "progress"
          }
        }
      }
    }
