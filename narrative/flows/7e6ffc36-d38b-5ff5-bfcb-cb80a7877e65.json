      "color": "#64748b",
      "options": [
        {
          "id": "dff41477-d119-56f2-9440-0b1b56f99a86",
          "text": "흐름이 왔을 때 밀어붙여야죠.",
          "sharedValues": {
            "8df1919d-9211-5e6e-a8d0-3040c8b5176c": "smod:mental:+1:1"
          }
        },
        {
          "id": "9120d144-6e52-5abc-8109-12b8cf2ac885",
          "text": "들뜨지 않게 훈련부터 다시 하겠습니다.",
          "sharedValues": {
            "8df1919d-9211-5e6e-a8d0-3040c8b5176c": "trust_all:+1;stress_all:-2"
          }
        },
        {
          "id": "322d802e-51a2-5e6c-95c9-809c69b6c659",
          "text": "다음 상대 생각은 내일 하겠습니다.",
          "sharedValues": {
            "8df1919d-9211-5e6e-a8d0-3040c8b5176c": "ok>trust_all:+2;ng>smod:tactics:-1:1"
          }
        }
      ],
      "translations": {
        "opt:dff41477-d119-56f2-9440-0b1b56f99a86": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "When the momentum comes, you push.",
            "status": "progress"
          }
        },
        "opt:9120d144-6e52-5abc-8109-12b8cf2ac885": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "We'll stay grounded and go back to training.",
            "status": "progress"
          }
        },
        "opt:322d802e-51a2-5e6c-95c9-809c69b6c659": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'll think about the next opponent tomorrow.",
            "status": "progress"
          }
        }
      }
    }
