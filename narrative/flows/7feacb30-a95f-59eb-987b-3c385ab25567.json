      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "이겼어요! 근데 제 플레이는 좀 아쉬웠어요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "We won! But my own play was a bit disappointing.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "0ad1c416-6815-5de2-bf2c-14c7de2c3eff",
      "type": "Comment",
      "name": "Comment",
      "localId": 4,
      "x": 340,
      "y": -220,
      "color": "#64748b",
      "text": "이야기 이벤트 설정",
