      "options": [
        {
          "id": "bc4bae74-d9c0-5dc7-b4b0-069215d36583",
          "text": "팀이 이겼잖아. 그거면 돼.",
          "sharedValues": {
            "f2a55848-6276-54f8-824e-05d4907ab893": "trust:+2;stress:-5"
          }
        },
        {
          "id": "ae5da9c7-8cb6-55f8-8d44-df5cde7cb0de",
          "text": "아쉬운 장면, 같이 짚어 보자.",
          "sharedValues": {
            "f2a55848-6276-54f8-824e-05d4907ab893": "ok>awaken:+10;ok>trust:+2;ng>stress:+4"
          }
        }
      ],
      "translations": {
        "opt:bc4bae74-d9c0-5dc7-b4b0-069215d36583": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "The team won. That's what matters.",
            "status": "progress"
          }
        },
        "opt:ae5da9c7-8cb6-55f8-8d44-df5cde7cb0de": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Let's go over the rough moments together.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "0746fd3b-5c8b-5d93-b7dd-9d0002a53de0",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 6,
      "x": 940,
      "y": -220,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "그렇죠! 다음엔 저도 더 잘할게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Right! I'll do better next time too.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "e2816a39-f256-523b-8f2e-b8753e84135c",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 940,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "네, 바로 보여 드릴게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Sure, let me show you right away.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "75ea338a-fd47-53a3-9b83-49653ae33c38": "ok"
      }
    },
    {
      "id": "30dd2297-bf74-5978-9f1c-ebb0c874dcda",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
