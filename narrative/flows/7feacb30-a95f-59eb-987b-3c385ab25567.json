      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…이긴 날인데요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…But we won today.",
            "status": "progress"
          }
        }
