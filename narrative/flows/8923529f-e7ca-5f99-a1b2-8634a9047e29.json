        },
        {
          "id": "ffa76364-60b0-54aa-adfd-435517757d50",
          "text": "{name2}, 네가 오늘 좀 챙겨 줘.",
          "sharedValues": {
            "38730afe-d24f-584e-a519-7647bd5bf91d": "ok>stress:-4;ok>trust:+2;ng>stress:+3"
          }
        }
      ],
      "translations": {
        "opt:98dee445-1638-5d25-b895-e0bb278cfa48": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Both of you, head in early today.",
            "status": "progress"
          }
        },
        "opt:ffa76364-60b0-54aa-adfd-435517757d50": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "{name2}, look after them today.",
            "status": "progress"
          }
        }
      }
    },
    {
