      "color": "#64748b",
      "speakerId": "6b1de2e5-536b-5673-b2c0-0f81cf838865",
      "content": "얘 오늘 무리했어요. 좀 쉬게 해 주세요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "They overdid it today. Please let them rest.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "e534787b-dcea-5180-93fb-4618f84f1700",
