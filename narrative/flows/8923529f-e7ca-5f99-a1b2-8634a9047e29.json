        {
          "id": "98dee445-1638-5d25-b895-e0bb278cfa48",
          "text": "둘 다 오늘은 일찍 들어가.",
          "sharedValues": {
            "38730afe-d24f-584e-a519-7647bd5bf91d": "stress:-6;trust:+1"
