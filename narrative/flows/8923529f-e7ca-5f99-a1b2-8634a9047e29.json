      "y": 170,
      "color": "#64748b",
      "speakerId": "6b1de2e5-536b-5673-b2c0-0f81cf838865",
      "content": "맡겨 주세요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Leave it to me.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "0c7db511-92e7-5fe2-844a-aece57e3326b": "ok"
