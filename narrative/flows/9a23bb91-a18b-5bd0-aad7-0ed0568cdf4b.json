        {
          "id": "afa8f899-829f-56b2-b71a-247856543257",
          "text": "털고 일어나자. 다음 주가 있어.",
          "sharedValues": {
            "b2a49dc8-35de-515d-96ec-139dd3d94515": "trust:+2;stress:-6"
          }
        },
        {
          "id": "91192801-96de-5c33-81ab-81c5136cd49a",
          "text": "패배에서 배울 게 더 많아. 복기하자.",
          "sharedValues": {
            "b2a49dc8-35de-515d-96ec-139dd3d94515": "awaken:+8;tlexp:+15;stress:+4"
          }
        }
      ],
      "translations": {
        "opt:afa8f899-829f-56b2-b71a-247856543257": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Shake it off. There's next week.",
            "status": "progress"
          }
        },
        "opt:91192801-96de-5c33-81ab-81c5136cd49a": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "A loss teaches more. Let's review.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "47dfbd3d-a31e-500d-a43b-6eec591109a9",
