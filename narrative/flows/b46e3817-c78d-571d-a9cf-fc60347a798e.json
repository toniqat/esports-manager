      "options": [
        {
          "id": "c6dba375-de64-5073-9815-fb97b9f5c180",
          "text": "저희 선수들을 믿습니다.",
          "sharedValues": {
            "43ccfc95-76c4-568c-bf0d-7c472e0d6f9e": "trust_all:+2"
          }
        },
        {
          "id": "56b9985e-6b58-5ba7-b7d3-bc402ce5be00",
          "text": "쉽지 않겠지만 준비한 게 있습니다.",
          "sharedValues": {
            "43ccfc95-76c4-568c-bf0d-7c472e0d6f9e": "smod:tactics:+1:1"
          }
        },
        {
          "id": "2a550cc6-33ef-5b22-8f9c-39fa517940c2",
          "text": "질문이 좀 무례하시네요.",
          "sharedValues": {
            "43ccfc95-76c4-568c-bf0d-7c472e0d6f9e": "trust_all:+1;smod:mental:-1:1"
          }
        }
      ],
      "translations": {
        "opt:c6dba375-de64-5073-9815-fb97b9f5c180": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I believe in my players.",
            "status": "progress"
          }
        },
        "opt:56b9985e-6b58-5ba7-b7d3-bc402ce5be00": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "It won't be easy, but we've prepared something.",
            "status": "progress"
          }
        },
        "opt:2a550cc6-33ef-5b22-8f9c-39fa517940c2": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "That's a bit of a rude question.",
            "status": "progress"
