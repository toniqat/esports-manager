          }
        }
      ],
      "translations": {
        "opt:6225ac94-516d-54eb-b466-c668928a1f1b": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "{name} is the core of our team. I trust them.",
            "status": "progress"
          }
        },
        "opt:5427f68c-2ee0-5c7f-baac-d6068db28c37": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "They know it better than anyone.",
            "status": "progress"
          }
        },
        "opt:6b22000c-e4fb-5539-904e-cf0b6eda70d5": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'll take a cold, hard look at it.",
            "status": "progress"
          }
        }
