            "51118bbd-4411-5685-bdb4-bfe299a78251": "trust:+4"
          }
        },
        {
          "id": "5427f68c-2ee0-5c7f-baac-d6068db28c37",
          "text": "본인이 누구보다 잘 알 겁니다.",
          "sharedValues": {
