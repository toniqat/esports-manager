          "text": "새 장비로 바로 적응하자.",
          "sharedValues": {
            "b2520d2a-ef22-5dfe-b1f0-617ee29651e1": "ok>pmod:engage_hit:+1:1;ng>pmod:engage_hit:-3:1"
