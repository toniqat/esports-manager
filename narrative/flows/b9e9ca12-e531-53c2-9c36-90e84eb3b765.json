      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "The match gear died in the middle of practice.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "58070539-9693-5929-8313-b1f011692fbf",
