          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Let's get used to new gear right away.",
            "status": "progress"
          }
        },
        "opt:5e5fe29a-f614-540e-8e56-4b5d07c5843b": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Let's rush-order the same model.",
            "status": "progress"
          }
        }
      }
    },
