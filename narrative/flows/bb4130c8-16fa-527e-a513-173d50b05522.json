      "color": "#64748b",
      "options": [
        {
          "id": "0a06ca21-815a-57ff-9ebe-0120effdc8c5",
          "text": "아직 안 죽었지?",
          "sharedValues": {
            "89f83095-ff67-5656-b18c-0df3319f130e": "trust:+5;pmod:all:+1:-1"
          }
        },
        {
          "id": "9e82bc12-22a0-592f-900e-4473b3246550",
          "text": "봐준 거야. 다음엔 진짜로 해.",
          "sharedValues": {
            "89f83095-ff67-5656-b18c-0df3319f130e": "trust:+6;pmod:all:+1:-1"
          }
        }
      ],
      "translations": {
        "opt:0a06ca21-815a-57ff-9ebe-0120effdc8c5": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Still got it, huh?",
            "status": "progress"
          }
        },
        "opt:9e82bc12-22a0-592f-900e-4473b3246550": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I went easy on you. Next time, for real.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "1bbabbf7-70ea-53ae-a823-6989773154e5",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1540,
      "y": -90.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "인정이요. 진짜 잘하시네요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Respect. You're actually really good.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "c8b7d5b4-8792-5b91-98dc-d399bec994a9",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 9,
      "x": 1540,
      "y": 170.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "다음엔 제가 이겨요!",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Next time I'm winning!",
            "status": "progress"
          }
        }
      }
    }
