    },
    {
      "id": "9f70e8e0-0d1a-55a3-943a-743c872151c7",
      "type": "Select",
      "name": "Select",
      "localId": 5,
      "x": 640,
      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "aa3e97a2-34f7-5397-948d-6211f9dc59c0",
          "text": "루틴을 지키면 돼. 같이 짜 볼까?",
          "sharedValues": {
            "c406729d-b478-5327-a6b3-343995f2e0b0": "trust:+4;pmod:field_eva:+1:2"
          }
        },
        {
          "id": "f6b09ef2-c42a-531f-bf1d-904e2c797479",
          "text": "나도 속으론 떨려.",
          "sharedValues": {
            "c406729d-b478-5327-a6b3-343995f2e0b0": "trust:+5"
          }
        }
      ],
      "translations": {
        "opt:aa3e97a2-34f7-5397-948d-6211f9dc59c0": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Just stick to a routine. Want to build one together?",
            "status": "progress"
          }
        },
        "opt:f6b09ef2-c42a-531f-bf1d-904e2c797479": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'm nervous inside too.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "7136561c-04ee-55a2-b271-978845500bdb",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 6,
      "x": 940,
      "y": -90.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "루틴이요? 좋아요 해 볼게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "A routine? Sounds good, I'll give it a shot.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "b033aa53-3293-5891-b6a4-bab353e91d5f",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 940,
      "y": 170.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "감독님도요? 의외네요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "You too? That's surprising.",
            "status": "progress"
          }
        }
      }
    }
