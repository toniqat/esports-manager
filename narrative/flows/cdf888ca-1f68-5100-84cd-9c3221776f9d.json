    {
      "id": "304575c4-1a64-569f-9fc6-0cd6d07c32dd",
      "type": "Select",
      "name": "Select",
      "localId": 7,
      "x": 1240,
      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "9968e459-8593-5b88-9118-1e1e72b3f107",
          "text": "바로 병원 가자. 훈련은 쉬어.",
          "sharedValues": {
            "c73bd934-97a0-5f05-acea-d48afe341d31": "trust:+3;pmod:all:-2:1"
          }
        },
        {
          "id": "29ae6ec7-11fe-566a-8c85-7802029e49bf",
          "text": "테이핑하고 오늘만 버티자.",
          "sharedValues": {
            "c73bd934-97a0-5f05-acea-d48afe341d31": "ok>pmod:all:-1:1;ng>pmod:all:-4:2;ng>trust:-3"
          }
        }
      ],
      "translations": {
        "opt:9968e459-8593-5b88-9118-1e1e72b3f107": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "We're going to the hospital now. Skip practice.",
            "status": "progress"
          }
        },
        "opt:29ae6ec7-11fe-566a-8c85-7802029e49bf": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Tape it up and get through today.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "5217f591-d161-55cf-9aa4-32e981169c69",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1540,
      "y": -90,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "네… 빨리 나을게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Okay… I'll heal up fast.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "f5089858-5491-514c-baa9-91dd7aa44a9e",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 9,
      "x": 1540,
      "y": 170,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "생각보다 괜찮네요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Huh, it's better than I thought.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "f28360e8-a201-58aa-99ad-1bce7ce2277e": "ok"
      }
    },
    {
      "id": "a3252cb7-15ad-5de7-ad3d-62c51e9e5166",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 10,
      "x": 1840,
      "y": 170,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "악… 더 아파졌어요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Ow… it hurts even more now.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "f28360e8-a201-58aa-99ad-1bce7ce2277e": "ng"
      }
