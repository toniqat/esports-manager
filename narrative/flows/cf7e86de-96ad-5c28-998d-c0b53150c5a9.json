        {
          "id": "f815b9c8-f640-5e0b-ac59-c295149d1c99",
          "text": "전혀요. {name}{eul} 믿습니다.",
          "sharedValues": {
            "cba11362-07c4-56ad-977b-728d5c21b90a": "ok>trust:+5;ng>trust:+2"
          }
        },
        {
          "id": "f42a9b97-625c-51f7-a995-bd55b143a40c",
          "text": "컨디션을 보고 판단하겠습니다.",
          "sharedValues": {
            "cba11362-07c4-56ad-977b-728d5c21b90a": "trust:+1"
          }
        },
        {
          "id": "97078c07-5c99-5ff8-b948-6793ffdd88f2",
          "text": "부진은 사실이죠.",
          "sharedValues": {
            "cba11362-07c4-56ad-977b-728d5c21b90a": "trust:-4;smod:mental:+1:1"
          }
        }
      ],
      "translations": {
        "opt:f815b9c8-f640-5e0b-ac59-c295149d1c99": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Not at all. I believe in {name}.",
            "status": "progress"
          }
        },
        "opt:f42a9b97-625c-51f7-a995-bd55b143a40c": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'll decide based on their condition.",
            "status": "progress"
          }
        },
        "opt:97078c07-5c99-5ff8-b948-6793ffdd88f2": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "They did struggle, that's a fact.",
            "status": "progress"
          }
        }
      }
