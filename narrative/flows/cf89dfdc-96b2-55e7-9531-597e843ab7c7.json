      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "8bed5f5e-99be-506e-a8f0-c860dac36a12",
          "text": "오늘은 쉬자. 잘했어.",
          "sharedValues": {
            "84529e45-2e63-523a-8f95-cbfe84463308": "trust:+4"
          }
        },
        {
          "id": "eba52c47-c948-5322-9728-82672e1fb5c8",
          "text": "이길 때 더 다져야지.",
          "sharedValues": {
            "84529e45-2e63-523a-8f95-cbfe84463308": "ok>trust:+2;ng>trust:-2"
          }
        }
      ],
      "translations": {
        "opt:8bed5f5e-99be-506e-a8f0-c860dac36a12": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Take the night off. Well played.",
            "status": "progress"
          }
        },
        "opt:eba52c47-c948-5322-9728-82672e1fb5c8": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Winning is when you tighten things up.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "d6a84033-0cf8-5b98-b124-9557280099cc",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 6,
      "x": 940,
      "y": -90.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "역시 감독님!",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "That's our coach!",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "8164fc64-b296-502f-9375-731014c58433",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 7,
      "x": 940,
      "y": 170.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…맞아요. 복기부터 할게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…Fair. I'll start with the review.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "dafb903d-c190-5ca6-8065-d6324e5fc30e": "ok"
      }
    },
    {
      "id": "70167339-dcd8-5daa-a6a2-341753ac498c",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1240,
      "y": 170.0,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "이겨도 쉬지를 못하네…",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Can't even rest after a win…",
            "status": "progress"
          }
        }
      },
