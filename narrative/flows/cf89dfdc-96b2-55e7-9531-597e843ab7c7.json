        "307c3a28-cd47-5800-9546-4f226fd7b4f7": 0,
        "e6b012f2-b1ca-5848-b1a3-923d8a580f70": "last=win",
        "a3497030-74fe-55ce-98d6-b40cfeb0cf00": 1
      }
    },
    {
      "id": "e950badc-a1fe-5961-91c4-8a5a9b721fae",
      "type": "Select",
      "name": "Select",
      "localId": 5,
