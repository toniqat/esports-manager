      }
    },
    {
      "id": "1cb3984c-29ed-5cda-94bb-ff97c0b6cc6f",
      "type": "Select",
      "name": "Select",
      "localId": 7,
      "x": 1240,
      "y": 40,
      "color": "#64748b",
      "options": [
        {
          "id": "0aa349f1-c3c5-512a-9b84-444a938f9b7a",
          "text": "벌금이야. 규칙은 규칙.",
          "sharedValues": {
            "7f1c2dc0-10c4-50d4-977f-4679cbb53ae7": "trust_all:+1;trust:-2"
          }
        },
        {
          "id": "906c231c-6a68-57b6-8a99-c418f5f15cca",
          "text": "다음부턴 조심해.",
          "sharedValues": {
            "7f1c2dc0-10c4-50d4-977f-4679cbb53ae7": "trust:+2;trust_all:-1"
          }
        },
        {
          "id": "124b2f9d-ecdc-5c05-b074-77325c2f563e",
          "text": "무슨 일 있었어?",
          "sharedValues": {
            "7f1c2dc0-10c4-50d4-977f-4679cbb53ae7": "ok>trust:+4;ng>trust:+1"
          }
        }
      ],
      "translations": {
        "opt:0aa349f1-c3c5-512a-9b84-444a938f9b7a": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "That's a fine. Rules are rules.",
            "status": "progress"
          }
        },
        "opt:906c231c-6a68-57b6-8a99-c418f5f15cca": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Be careful next time.",
            "status": "progress"
          }
        },
        "opt:124b2f9d-ecdc-5c05-b074-77325c2f563e": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Did something happen?",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "40d04fba-88fd-5c25-81d9-a222d07d60b0",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1540,
      "y": -220,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…네. 내겠습니다.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…Okay. I'll pay it.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "bef14e27-68b9-541e-9040-552d4de3c0b8",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 9,
      "x": 1540,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "감사합니다!",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Thank you!",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "3c4c7627-0ffe-5781-9e6f-47c9982d8e56",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 10,
      "x": 1540,
      "y": 300,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "사실 요즘 잠을 잘 못 자요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Actually, I haven't been sleeping well lately.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "236c56be-ae7b-5cb7-8515-1975bded635b": "ok"
      }
    },
    {
      "id": "41470b9d-0787-58e9-9482-349908a35dd5",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 11,
      "x": 1840,
      "y": 300,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "그냥 늦잠이에요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I just overslept.",
            "status": "progress"
          }
        }
      },
      "sharedValues": {
        "236c56be-ae7b-5cb7-8515-1975bded635b": "ng"
      }
    }
