      "y": 40,
      "color": "#64748b",
      "speakerId": null,
      "content": "{name} 선수가 오전 훈련에 한 시간 늦었다.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "{name} was an hour late to morning practice.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "3dc6e59b-3abe-5a1e-95cd-3d04bca8328c",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 5,
      "x": 940,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "죄송해요! 알람을 못 들었어요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "I'm sorry! I didn't hear my alarm.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "7ef26a4c-467e-5385-9bae-c7d0dd7bef85",
      "type": "Comment",
      "name": "Comment",
      "localId": 6,
      "x": 340,
      "y": -220,
      "color": "#64748b",
      "text": "사건 이벤트 설정",
      "width": 260,
      "height": 110,
      "attachments": [
        {
          "nodeId": "b83d4411-5b04-5389-b980-231391aa0db9"
        }
      ],
