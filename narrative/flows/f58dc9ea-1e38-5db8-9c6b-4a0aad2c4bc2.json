      "options": [
        {
          "id": "564a335f-1729-59b0-8843-189ba07db0bd",
          "text": "조금만 더 하고 자.",
          "sharedValues": {
            "81ffa541-aafa-5270-9794-6b6b745ead3c": "awaken:+15;stress:+6"
          }
        },
        {
          "id": "cbdbbab9-2c7d-5da8-8d88-f5e0cfba2fec",
          "text": "내일 하자. 지금은 자야 해.",
          "sharedValues": {
            "81ffa541-aafa-5270-9794-6b6b745ead3c": "stress:-5;trust:+2"
          }
        }
      ],
      "translations": {
        "opt:564a335f-1729-59b0-8843-189ba07db0bd": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Go a little longer, then sleep.",
            "status": "progress"
          }
        },
        "opt:cbdbbab9-2c7d-5da8-8d88-f5e0cfba2fec": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Tomorrow. You need sleep now.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "c8c693d4-7c77-5db0-90d2-95422e58376c",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 8,
      "x": 1540,
      "y": -220,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "네! 금방 끝낼게요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "Okay! I'll wrap up soon.",
            "status": "progress"
          }
        }
      }
    },
    {
      "id": "eb04f636-02f0-5787-a282-c0f8c89c6035",
      "type": "Dialog",
      "name": "Dialog",
      "localId": 9,
      "x": 1540,
      "y": 40,
      "color": "#64748b",
      "speakerId": "0a3f02b0-80bb-5e10-8f8d-897f9e479f2a",
      "content": "…네, 알겠어요.",
      "statements": [],
      "childFlowId": null,
      "labelIds": [],
      "translations": {
        "content": {
          "1fc639b5-44de-55c2-9e8c-9a9a525ac8d4": {
            "text": "…Okay, got it.",
            "status": "progress"
          }
        }
